{
  "description": "A median accelerator time above the median latency without the warning.",
  "base": "docs/examples/v1.2.0/example-npu-int8-profiled-pass-cache-hit.json",
  "set": {
    "/timing/profiled_pass/accelerator_ms/median_ms": 0.5,
    "/timing/profiled_pass/accelerator_ms/max_ms": 0.6
  },
  "expect": {
    "severity": "error",
    "code": "accelerator_exceeds_latency_unflagged",
