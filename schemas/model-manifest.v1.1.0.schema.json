{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mstfaatf/edgebench/main/schemas/model-manifest.v1.1.0.schema.json",
  "title": "EdgeBench model manifest",
  "description": "models/manifest.json: the committed index of every model file, what it is and which file it was made from. Manifest version 1.1.0. Lineage (every parent present, ending at a root with FP32 precision and external normalization: the FP32 export of an exported model, the imported source graph of an imported model) is checked by scripts/common/model_registry.py lineage_problems(). 1.1.0 adds the variant fp32_imported (imported models); see docs/models.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "description", "tools", "files"],
  "properties": {
    "manifest_version": {"const": "1.1.0"},
    "description": {"type": "string"},
    "tools": {
      "description": "Versions of the export tools the files were made with.",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256", "size_bytes", "model", "variant", "precision", "normalization", "batch_size",
                     "pruned", "parent_sha256"],
        "properties": {
          "file": {"type": "string", "pattern": "^[a-z0-9_]+/[a-z0-9_]+\\.onnx$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "model": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "variant": {"enum": ["fp32", "fp32_imported", "fp32_folded", "int8", "int8_unpruned", "int8_folded", "int8_folded_unpruned"]},
          "precision": {"enum": ["fp32", "int8"]},
          "normalization": {"enum": ["external", "folded"]},
          "batch_size": {"type": "integer", "minimum": 1},
          "pruned": {"type": ["boolean", "null"], "description": "INT8 only: dead Q/DQ chains removed; null for FP32."},
          "parent_sha256": {
            "description": "SHA256 of the file this one was made from; null for a root (an FP32 export, or an imported source graph).",
            "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
          }
        },
        "allOf": [
          {
            "if": {"properties": {"precision": {"const": "fp32"}}},
            "then": {"properties": {"pruned": {"type": "null"}}},
            "else": {"properties": {"pruned": {"type": "boolean"}}}
          },
          {
            "if": {"properties": {"variant": {"const": "fp32_imported"}}},
            "then": {"properties": {"parent_sha256": {"type": "null"}, "precision": {"const": "fp32"}}}
          },
          {
            "description": "fp32 is a root for exported models and the cleaned graph (with a parent) for imported ones; lineage_problems() decides per model.",
            "if": {"properties": {"variant": {"not": {"enum": ["fp32", "fp32_imported"]}}}},
            "then": {"properties": {"parent_sha256": {"type": "string"}}}
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
