# Writes a header with the git commit and dirty flag of the source tree.
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> [-DGIT_EXECUTABLE=<git>] -P BuildInfo.cmake
#
# Run as a build step (not at configure time) so the values follow new commits
# without reconfiguring. The header is only rewritten when its content changes,
# so an unchanged tree does not trigger recompilation.

set(_commit "")
set(_dirty -1)  # -1: unknown
if(GIT_EXECUTABLE)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(_rc EQUAL 0 AND _out MATCHES "^[0-9a-f]+$")
    set(_commit "${_out}")
    # Tracked files only: untracked files do not change what is built.
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
      WORKING_DIRECTORY "${SOURCE_DIR}"
      RESULT_VARIABLE _rc OUTPUT_VARIABLE _status ERROR_QUIET)
    if(_rc EQUAL 0)
      if(_status STREQUAL "")
        set(_dirty 0)
      else()
        set(_dirty 1)
      endif()
    endif()
  endif()
endif()

set(_content "// Generated by cmake/BuildInfo.cmake. Do not edit.
#pragma once

// Empty if the source tree is not a git checkout.
#define EDGEBENCH_GIT_COMMIT \"${_commit}\"
// 1: uncommitted changes to tracked files, 0: clean, -1: unknown.
#define EDGEBENCH_GIT_DIRTY ${_dirty}
")
set(_tmp "${OUTPUT}.tmp")
file(WRITE "${_tmp}" "${_content}")
file(COPY_FILE "${_tmp}" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${_tmp}")
