# Reads cmake/bundle-pins.json, the versions and SHA256 pins of the ONNX Runtime
# and QNN execution provider binaries (also read by scripts/fetch_deps.ps1), and
#
#   - sets EDGEBENCH_ONNXRUNTIME_VERSION, EDGEBENCH_QNN_EP_VERSION and
#     EDGEBENCH_QAIRT_SDK_VERSION;
#   - edgebench_generate_bundle_pins(<file>): writes a C++ header with the pinned
#     files of EDGEBENCH_TARGET_ARCH, for `edgebench doctor`.
#
# Editing the JSON file reconfigures the build.

set(EDGEBENCH_BUNDLE_PINS_FILE "${CMAKE_CURRENT_LIST_DIR}/bundle-pins.json")
set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${EDGEBENCH_BUNDLE_PINS_FILE}")
file(READ "${EDGEBENCH_BUNDLE_PINS_FILE}" _edgebench_pins)

string(JSON EDGEBENCH_ONNXRUNTIME_VERSION GET "${_edgebench_pins}" onnxruntime version)
string(JSON EDGEBENCH_ONNXRUNTIME_API_VERSION GET "${_edgebench_pins}" onnxruntime api_version)
string(JSON EDGEBENCH_QNN_EP_VERSION GET "${_edgebench_pins}" onnxruntime_qnn version)
string(JSON EDGEBENCH_QAIRT_SDK_VERSION GET "${_edgebench_pins}" onnxruntime_qnn qairt_sdk_version)

# C++ initializers {"name", size, "sha256"} for one files list of the JSON file.
function(_edgebench_pinned_files out component)
  set(entries "")
  string(JSON count LENGTH "${_edgebench_pins}" ${component} files ${EDGEBENCH_TARGET_ARCH})
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
      string(JSON name GET "${_edgebench_pins}" ${component} files ${EDGEBENCH_TARGET_ARCH} ${i} name)
      string(JSON size GET "${_edgebench_pins}" ${component} files ${EDGEBENCH_TARGET_ARCH} ${i} size_bytes)
      string(JSON sha GET "${_edgebench_pins}" ${component} files ${EDGEBENCH_TARGET_ARCH} ${i} sha256)
      string(APPEND entries "    PinnedFile{\"${name}\", ${size}ull, \"${sha}\"},\n")
    endforeach()
  endif()
  set(${out} "${entries}" PARENT_SCOPE)
  set(${out}_COUNT ${count} PARENT_SCOPE)
endfunction()

function(edgebench_generate_bundle_pins header)
  _edgebench_pinned_files(ort_files onnxruntime)
  _edgebench_pinned_files(qnn_files onnxruntime_qnn)
  file(CONFIGURE OUTPUT "${header}" @ONLY CONTENT
"// Generated by CMake from cmake/bundle-pins.json (cmake/BundlePins.cmake). Do not edit.
#pragma once

#include <array>
#include <cstdint>
#include <string_view>

namespace edgebench::pins {

struct PinnedFile {
    std::string_view name;
    std::uint64_t size_bytes;
    std::string_view sha256;
};

inline constexpr std::string_view kPinsFile = \"cmake/bundle-pins.json\";
inline constexpr std::string_view kTargetArch = \"@EDGEBENCH_TARGET_ARCH@\";
inline constexpr std::string_view kOnnxRuntimeVersion = \"@EDGEBENCH_ONNXRUNTIME_VERSION@\";
inline constexpr std::string_view kQnnEpVersion = \"@EDGEBENCH_QNN_EP_VERSION@\";
/// The QAIRT (QNN) SDK version the QNN EP release declares it is built with.
inline constexpr std::string_view kQairtSdkVersion = \"@EDGEBENCH_QAIRT_SDK_VERSION@\";

/// The ONNX Runtime files of this build's architecture.
inline constexpr std::array<PinnedFile, @ort_files_COUNT@> kOnnxRuntimeFiles = {{
@ort_files@}};

/// The QNN execution provider files (empty where the build has no QNN EP).
inline constexpr std::array<PinnedFile, @qnn_files_COUNT@> kQnnFiles = {{
@qnn_files@}};

}  // namespace edgebench::pins
")
endfunction()
