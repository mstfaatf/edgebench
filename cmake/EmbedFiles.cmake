# edgebench_embed_files(<header> <namespace> <name> <file> [<name> <file> ...])
#
# Writes a C++ header that holds each file's bytes as
#   inline constexpr unsigned char <name>[] = {...};
# in <namespace>, at configure time. Changing a file reconfigures the build. For
# small committed resources (a few KB) only.
function(edgebench_embed_files header namespace)
  set(body "")
  set(args ${ARGN})
  list(LENGTH args n)
  math(EXPR remainder "${n} % 2")
  if(n EQUAL 0 OR NOT remainder EQUAL 0)
    message(FATAL_ERROR "edgebench_embed_files: expected <name> <file> pairs")
  endif()
  while(args)
    list(POP_FRONT args name file)
    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # 16 bytes per line
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
    file(RELATIVE_PATH relative "${CMAKE_SOURCE_DIR}" "${file}")
    string(APPEND body "// ${relative} (${size} bytes)\ninline constexpr unsigned char ${name}[${size}] = {\n    ${bytes}\n};\n\n")
  endwhile()
  file(CONFIGURE OUTPUT "${header}" @ONLY CONTENT
"// Generated by CMake (cmake/EmbedFiles.cmake). Do not edit.
#pragma once

namespace @namespace@ {

@body@}  // namespace @namespace@
")
endfunction()
