{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "arm64-release",
      "displayName": "Windows ARM64 Release (Visual Studio 2022)",
      "description": "Native ARM64 build using the ARM64-hosted MSVC toolset. Works from any shell.",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "ARM64", "strategy": "set" },
      "toolset": { "value": "host=ARM64", "strategy": "set" },
      "binaryDir": "${sourceDir}/../../build/ort_probe/arm64-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    {
      "name": "arm64-release",
      "configurePreset": "arm64-release",
      "configuration": "Release"
    }
  ]
}
