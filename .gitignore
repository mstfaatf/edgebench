# Python
.venv*/
__pycache__/
*.pyc
.pytest_cache/

# C++ build output (all CMake presets build under build/)
build/
out/
.vs/
Testing/
CMakeUserPresets.json
compile_commands.json

# Scratch space
tmp/

# Downloaded datasets and native dependencies
data/
third_party/

# Generated caches (e.g. QNN EP context binaries; device- and SDK-specific)
cache/

# Locally produced models and their sidecars (only the README is committed)
models/*
!models/README.md
!models/manifest.json
!models/batch_equivalence.json
# Model sources that cannot be re-created locally (committed, pinned by SHA256)
!models/sources/

# Model binaries (small test fixtures are allowed)
*.onnx
*.pt
*.pth
*.h5
*.keras
*.bin
!**/tests/fixtures/**
!engine/resources/**
!models/sources/**

# Scratch benchmark results (published runs live in benchmarks/results/published/)
benchmarks/results/local/
