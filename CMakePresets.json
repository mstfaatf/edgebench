{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "arm64-base",
      "hidden": true,
      "description": "Native ARM64 build using the ARM64-hosted MSVC toolset. Works from any shell.",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "ARM64", "strategy": "set" },
      "toolset": { "value": "host=ARM64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "arm64-release",
      "displayName": "Windows ARM64 Release",
      "inherits": "arm64-base",
      "binaryDir": "${sourceDir}/build/arm64-release"
    },
    {
      "name": "arm64-debug",
      "displayName": "Windows ARM64 Debug",
      "inherits": "arm64-base",
      "binaryDir": "${sourceDir}/build/arm64-debug"
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "description": "Ninja Multi-Config with the MSVC compiler of the current developer environment; the environment's target architecture decides the build's.",
      "generator": "Ninja Multi-Config",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x64",
      "displayName": "Windows x64 (CPU only), Ninja, from an x64 MSVC developer environment",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build/x64"
    },
    {
      "name": "arm64-ninja",
      "displayName": "Windows ARM64, Ninja, from an ARM64 MSVC developer environment",
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/build/arm64-ninja"
    }
  ],
  "buildPresets": [
    { "name": "arm64-release", "configurePreset": "arm64-release", "configuration": "Release" },
    { "name": "arm64-debug", "configurePreset": "arm64-debug", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64", "configuration": "Release" },
    { "name": "x64-debug", "configurePreset": "x64", "configuration": "Debug" },
    { "name": "arm64-ninja-release", "configurePreset": "arm64-ninja", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "arm64-release",
      "configurePreset": "arm64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "arm64-debug",
      "configurePreset": "arm64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-debug",
      "configurePreset": "x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "arm64-ninja-release",
      "configurePreset": "arm64-ninja",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
